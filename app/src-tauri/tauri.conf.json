{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yatai",
  "version": "0.1.0",
  "identifier": "dev.yatai.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "yatai",
        "url": "index.html",
        "width": 372,
        "height": 800,
        "minWidth": 300,
        "minHeight": 72,
        "decorations": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "capture",
        "title": "yatai — capture",
        "url": "capture.html",
        "width": 520,
        "height": 92,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A thin window with what to do next",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
